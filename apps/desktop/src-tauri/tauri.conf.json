{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbus VPN",
  "version": "0.1.0",
  "identifier": "com.nimbusvpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Nimbus VPN", "width": 1180, "height": 800, "minWidth": 900, "minHeight": 650 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
